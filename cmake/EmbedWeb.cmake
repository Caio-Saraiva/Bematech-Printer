file(GLOB assets "${WEB_DIR}/*")
file(WRITE "${OUTPUT}" "/* Generated from web/. Do not edit. */\nstruct bp_asset { const char *path; const char *type; const unsigned char *data; size_t size; };\n")
set(entries "")
set(index 0)
foreach(asset IN LISTS assets)
  if(IS_DIRECTORY "${asset}")
    continue()
  endif()
  get_filename_component(name "${asset}" NAME)
  get_filename_component(ext "${asset}" EXT)
  set(type "application/octet-stream")
  if(ext STREQUAL ".html")
    set(type "text/html; charset=utf-8")
  elseif(ext STREQUAL ".js")
    set(type "application/javascript; charset=utf-8")
  elseif(ext STREQUAL ".css")
    set(type "text/css; charset=utf-8")
  elseif(ext STREQUAL ".svg")
    set(type "image/svg+xml")
  endif()
  file(READ "${asset}" hex HEX)
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
  file(APPEND "${OUTPUT}" "static const unsigned char asset_${index}[] = {${bytes}0};\n")
  string(APPEND entries "{\"/${name}\",\"${type}\",asset_${index},sizeof(asset_${index})-1},\n")
  math(EXPR index "${index}+1")
endforeach()
file(APPEND "${OUTPUT}" "static const struct bp_asset assets[] = {\n${entries}};\n")
